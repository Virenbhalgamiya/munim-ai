# Copy to .env and fill in:   copy .env.example .env      (PowerShell / cmd)
# Everything runs on real, free services. Required: one AI key. Recommended: a Telegram bot for reminders.

# --- AI (required) -------------------------------------------------------------
# groq   : https://console.groq.com/keys      (free, very fast — recommended for voice)
# gemini : https://aistudio.google.com/apikey (free, good Hindi)
# anthropic (paid, optional)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Model override (defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.5-flash, anthropic=claude-sonnet-5-5)
# List the models your key can use: GET https://api.groq.com/openai/v1/models
# LLM_MODEL=
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-safeguard-20b   # tried when the main model is rate-limited

# --- Login: real SMS OTP via Message Central VerifyNow (required) -----------------
# 1. Sign up at https://www.messagecentral.com  (free credits on signup, no DLT needed for OTP)
# 2. Dashboard -> Verify Now: copy your Customer ID; use the account password you set
# 3. Test:  python -m app.cli --check-otp
LOGIN_METHOD=otp                   # otp (SMS) | pin
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_PASSWORD=
MESSAGECENTRAL_EMAIL=
# MESSAGECENTRAL_AUTH_TOKEN=       # optional: paste an auth token instead of the password
# OTP_RESEND_SECONDS=60
# OTP_MAX_SENDS_PER_10_MIN=3
# OTP_VALID_MINUTES=5
# OTP_MAX_ATTEMPTS=5

# --- Developer mode (this computer only): skip phone + OTP login --------------
# true = the app logs you in automatically as the demo store. Only allowed with HOST=127.0.0.1.
DEV_MODE=false

# --- Voice output ----------------------------------------------------------------
# neural = natural Microsoft voices (Hindi Swara/Madhur, Marathi Aarohi/Manohar), free, needs internet
# browser = the browser's built-in voice
VOICE_ENGINE=neural
# TTS_RATE=-4%                    # speaking speed: "-10%" slower, "+5%" faster

# --- Telegram reminders (recommended) -------------------------------------------
# 1. Telegram -> @BotFather -> /newbot -> copy the token
# 2. Open your new bot and send it any message (e.g. "hi")
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates -> copy "chat":{"id": ...}
# 4. Test:  python -m app.cli --check-telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# REMINDER_COOLDOWN_HOURS=72      # no repeat reminder to the same customer within this window

# --- Database & synthetic demo data (SQLite, one local file) ------------------
# MUNIM_DB_PATH=data/munim.db
# SEED_DEMO_DATA=true             # load the demo store into an empty database on first start
# SEED_MERCHANT_PHONE=9822000001  # demo login phone
# SEED_MERCHANT_PIN=              # empty = random PIN, printed once on first start
# TODAY_MODE=data                 # data = "today" is the last day in the data; calendar = real date

# --- Server & security --------------------------------------------------------
# HOST=127.0.0.1                  # local only. Use 0.0.0.0 to allow other devices on your network
# PORT=8000
# SESSION_HOURS=12
# COOKIE_SECURE=false             # true when served over HTTPS
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# ASK_RATE_PER_MINUTE=20
# ADMIN_TOKEN=                    # set to enable GET /api/admin/metrics (header X-Admin-Token)
# LOG_LEVEL=INFO                  # logs go to logs/munim.log (JSON lines, rotated)
